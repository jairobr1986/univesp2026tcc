# Este arquivo é SOMENTE um modelo. A aplicação carrega .env, não .env.example.
# Não existe usuário/senha padrão. Crie o primeiro acesso no terminal:
# Windows: .\.venv\Scripts\python manage.py setup
# O comando pede usuário, nome, perfil e senha e cria/atualiza o .env.
# A senha digitada no terminal não aparece (nem como asteriscos).
# Para redefinir a senha, repita o setup com o mesmo usuário e reinicie o servidor.
# SECRET_KEY identifica sessões; APP_USERS contém perfis e hashes, não senhas em texto.
# Copie os valores para a Vercel SEM as aspas externas do dotenv.
# Nunca publique o .env, senhas, URLs de banco ou hashes de acesso.
SECRET_KEY=
APP_USERS={}

# Vazio: SQLite local pts-v2.db. Na Vercel, PostgreSQL é obrigatório.
# Neon: use a URL pooled fornecida pelo painel e mantenha sslmode=require.
# DATABASE_URL=postgresql://usuario:senha@host-pooler.neon.tech/banco?sslmode=require
DATABASE_URL=

# Compartilhamento manual é o padrão e não exige credenciais.
ENABLE_AUTO_SEND=0

# HTTPS externo fora da Vercel: configure 1 para cookies seguros.
COOKIE_SECURE=0

# Somente para envio automático opcional:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
PUBLIC_BASE_URL=
