{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "headers": [
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"Service-Worker-Allowed","value":"/"},{"key":"X-Content-Type-Options","value":"nosniff"}]},
    {"source":"/static/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}
  ]
}
